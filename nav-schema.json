{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NavBookmark",
  "description": "A single semantic bookmark exported from nav",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Absolute path to the bookmarked directory"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated list of semantic tags"
    }
  },
  "required": ["path", "tags"],
  "additionalProperties": false
}
